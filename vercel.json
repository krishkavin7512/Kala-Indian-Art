{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(css|js|lib|data)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "redirects": [
    { "source": "/timeline", "destination": "/timeline/index.html" },
    { "source": "/map", "destination": "/map/index.html" },
    { "source": "/fusion", "destination": "/fusion/index.html" },
    { "source": "/credits", "destination": "/credits/index.html" }
  ]
}
